+  // After each call in |body| that may change the state, trap if unwinding.
+  void addTrapOnUnwind(Expression* body) {
+    struct Adder : public PostWalker<Adder> {
+      AsyncifyFlow* parent;
+      void visitBlock(Block* block) {
+        for (auto*& item : block->list) {
+          wrap(item);
+        }
+      }
+      void visitIf(If* iff) {
+        wrap(iff->ifTrue);
+        if (iff->ifFalse) {
+          wrap(iff->ifFalse);
+        }
+      }
+      void visitLoop(Loop* loop) { wrap(loop->body); }
+      void wrap(Expression*& item) {
+        if (item->type != Type::none || !doesCall(item) ||
+            !parent->analyzer->canChangeState(item, parent->func)) {
+          return;
+        }
+        auto& builder = *parent->builder;
+        item = builder.makeSequence(
+          item,
+          builder.makeIf(builder.makeStateCheck(State::Unwinding),
+                         builder.makeUnreachable()));
+      }
+    } adder;
+    adder.parent = this;
+    adder.walk(body);
+  }
